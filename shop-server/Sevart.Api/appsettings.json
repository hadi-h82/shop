{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=SevartDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },


  "Jwt": {
    "Issuer": "Sevart.Api",
    "Audience": "Sevart.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30,
    "MaxActiveSessionsPerUser": 5
  },


  "Otp": {
    "CodeLength": 6,
    "ExpirationMinutes": 2,
    "ResendCooldownSeconds": 1,
    "MaxVerificationAttempts": 5,
    "MaxSendsPerPhonePerHour": 1000,
    "MaxSendsPerPhonePerDay": 5000,
    "MaxSendsPerIpPerHour": 2000,
    "MaxSendsPerIpPerDay": 10000
  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}