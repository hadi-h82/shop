{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=SevartDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },


  "Jwt": {
    "Issuer": "Sevart.Api",
    "Audience": "Sevart.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}